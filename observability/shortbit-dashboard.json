{
  "title": "shortbit",
  "uid": "shortbit-overview",
  "description": "API, redirects, cliques e segurança do shortbit (backend/docs/observability.md).",
  "tags": [
    "shortbit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {}
      },
      {
        "name": "service",
        "label": "Serviço",
        "type": "custom",
        "query": "shortbit-api,shortbit-worker",
        "multi": true,
        "includeAll": true,
        "allValue": "shortbit-.*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Visão geral",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requisições por minuto",
      "id": 2,
      "description": "Todas as rotas menos o health check da hospedagem, média do intervalo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/health/live\"}[$__rate_interval])) * 60",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Erros do servidor (5xx)",
      "id": 3,
      "description": "Parte das respostas que foram 5xx. — quando não houve requisições.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/health/live\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/health/live\"}[$__rate_interval]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Redirect p95",
      "id": 4,
      "description": "95% dos redirects respondem em até este tempo. — quando não houve redirect no intervalo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route=\"/{code}\"}[$__rate_interval])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Acertos do cache",
      "id": 5,
      "description": "Redirects públicos atendidos pelo Redis, sem ir ao PostgreSQL. — quando não houve redirect público.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum(rate(shortbit_destination_cache_lookups_total{job=~\"$service\", result=\"hit\"}[$__rate_interval])) / sum(rate(shortbit_destination_cache_lookups_total{job=~\"$service\"}[$__rate_interval]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Tráfego",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requisições por rota",
      "id": 7,
      "description": "none = respondida antes de escolher a rota, como no bloqueio por limite. O health check da hospedagem fica de fora.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/health/live\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Respostas por status",
      "id": 8,
      "description": "Sem o health check da hospedagem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/health/live\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Tempo de resposta p95 por rota",
      "id": 9,
      "description": "Sem o health check da hospedagem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\", http_route!=\"/health/live\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Redirects por resultado e origem",
      "id": 10,
      "description": "source: link (abriu o link curto) ou qr (leu o QR code).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (result, source) (rate(shortbit_redirects_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{result}} · {{source}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Cliques",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Como os cliques foram registrados",
      "id": 12,
      "description": "queued: pela fila. synchronous: plano B direto no PostgreSQL, a fila falhou. not_recorded: nenhum dos dois, o visitante recebeu 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (outcome) (rate(shortbit_click_events_published_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "O que o worker fez",
      "id": 13,
      "description": "counted, duplicate (reentrega já contada), discarded (link apagado), failed (vai tentar de novo), dead_lettered (evento inválido).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (outcome) (rate(shortbit_click_events_processed_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Atraso entre o clique e a contagem",
      "id": 14,
      "description": "Quanto o número da página do link atrasa em relação ao clique.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shortbit_click_events_lag_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shortbit_click_events_lag_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Conexões com o PostgreSQL",
      "id": 15,
      "description": "Em uso colado no máximo por muito tempo = requisições esperando conexão.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(db_client_connections_in_use{job=~\"$service\"})",
          "legendFormat": "em uso"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(db_client_connections_idle{job=~\"$service\"})",
          "legendFormat": "ociosas"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(db_client_connections_max{job=~\"$service\"})",
          "legendFormat": "máximo"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Segurança",
      "id": 16,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Eventos de segurança",
      "id": 17,
      "description": "login_failed, google_login_failed, rate_limited, link_password_failed, verification_code_failed e mudanças de conta.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (event) (increase(shortbit_security_events_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Últimos eventos de segurança",
      "id": 18,
      "description": "Clique numa linha para ver event, reason, limiter e user_id. Nunca há email ou IP.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"$service\"} |= \"security event\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "type": "row",
      "title": "Aplicação",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memória do Go",
      "id": 20,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (job) (go_memory_used_bytes{job=~\"$service\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
